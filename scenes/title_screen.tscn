theme_override_colors/font_color = Color(0.91, 0.27, 0.38, 1)
text = "BRICK"
horizontal_alignment = 1

[node name="TitleLabel2" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_fonts/font = ExtResource("3_font")
theme_override_font_sizes/font_size = 42
theme_override_colors/font_color = Color(0.91, 0.27, 0.38, 1)
text = "BREAKER"
horizontal_alignment = 1

[node name="SubtitleLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_fonts/font = ExtResource("3_font")
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.67, 0.67, 0.67, 1)
text = "A Classic Arcade Game"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 50)

[node name="PlayButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(200, 50)
theme_override_fonts/font = ExtResource("3_font")
